# ===== 开发环境（task dev / compose-dev.yaml）=====
API_PORT=4000
ANNOUNCEMENTS_DIR=
# 开发走 Next rewrites 同源代理：必须留空（非空则前端直连该 API 基址）
NEXT_PUBLIC_API_BASE_URL=
# 允许的浏览器访问源。生产栈（task prod:up，:3000）和公网域名也必须写入，
# 否则多人 WebSocket 会被 Origin 校验拒绝；不要在 Origin 末尾加斜杠。
WEB_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://touhouflandre.com,http://localhost:5173,http://127.0.0.1:5173"
POSTGRES_PASSWORD=touhouflandre-dev
DATABASE_URL_PG="postgres://touhouflandre:touhouflandre-dev@127.0.0.1:5433/touhouflandre"
GOOSE_DBSTRING="postgres://touhouflandre:touhouflandre-dev@127.0.0.1:5433/touhouflandre?sslmode=disable"
GOOSE_DRIVER=postgres

# ===== 生产（compose.yaml，cloudflared 公网暴露）=====
# 浏览器访问源 = https://<cloudflared 隧道公网域名>，WS 升级校验 Origin 必须匹配。
# 多域名/本地并存：逗号分隔，如上方 WEB_ORIGINS。

# cloudflared 隧道指向宿主机端口：
#   web（HTTP+WS 全流量）→ http://localhost:3000
#   api（可选直连调试）  → http://localhost:4000

# API 可调参数（默认值 = apps/api/internal/config/config.go；不填用默认）
LOG_LEVEL=info
# 游戏内角色搜索默认只显示该局题库选中的角色；关闭后恢复全快照候选。
CHARACTER_SEARCH_QUESTION_SCOPE_FILTER_ENABLED=true
MULTI_LOBBY_TTL=30m
MULTI_EVENT_RETENTION=24h
MULTI_CHAT_RETENTION=24h
MULTI_SYSTEM_ANNOUNCEMENTS_ENABLED=true
MULTI_CHAT_MEMBER_CAPACITY=5
MULTI_CHAT_MEMBER_REFILL=2s
MULTI_CHAT_ROOM_CAPACITY=20
MULTI_CHAT_ROOM_REFILL=500ms
# 可单独轮换；留空时从 MULTI_PROJECTION_SECRET 做域隔离派生
MULTI_CHAT_CURSOR_SECRET=
MULTI_MODE_REGISTRY=full
MULTI_N_PLAYER_RELAY_ENABLED=true
MULTI_RELAY_ELIMINATION_ENABLED=true
NEXT_PUBLIC_MULTI_N_PLAYER_RELAY_ENABLED=true
NEXT_PUBLIC_MULTI_RELAY_ELIMINATION_ENABLED=true
MULTI_JOIN_RATE_LIMIT=10
MULTI_RELAY_HISTORY_RATE_LIMIT=60
MULTI_ROUND_COUNTDOWN=3s
MULTI_INTERMISSION=5s
MULTI_ROUND_SECONDS=900s
MULTI_RACE_ROUND_SECONDS=300s
MULTI_TURN_SECONDS=60s
MULTI_DISCONNECT_GRACE=60s
MULTI_MAX_ROUNDS_FACTOR=3
MULTI_FINISHED_RETENTION=30m
MULTI_WS_READ_LIMIT=4096
MULTI_WS_SEND_QUEUE=64
# 生产环境必填；留空时进程启动会生成临时 256-bit 随机密钥
MULTI_PROJECTION_SECRET=

# 可选监控 profile：docker compose --profile monitoring up -d
# 仅绑定本机；对外开放 Grafana 前必须替换默认密码。
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin
