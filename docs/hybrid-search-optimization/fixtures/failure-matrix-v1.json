{
  "contract": "hso.failure-matrix.v1",
  "catalogVersion": "catalog-v1",
  "indexSchemaVersion": 1,
  "policyRevision": "v1",
  "fallbackReasons": [
    "policy_remote",
    "policy_unavailable",
    "context_incomplete",
    "index_transient",
    "index_invalid",
    "engine_error"
