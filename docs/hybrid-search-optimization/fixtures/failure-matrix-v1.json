  "cases": [
    {
      "name": "policy cold start 404",
      "state": {
        "hasValidatedPolicy": false,
        "hasLoadedIndex": false,
        "catalogVersion": "catalog-v1",
        "indexSchemaVersion": 1,
        "policyRevision": null,
        "lastKnownGoodAgeSeconds": null,
        "retryStage": 0
      },
      "policyResponse": {
        "kind": "response",
        "status": 404,
        "body": "not-found"
      },
      "indexResponse": null,
      "expected": {
        "resultSource": "remote",
        "faultClass": "policy_missing",
        "nextProbeAfterSeconds": 60,
        "fallbackReason": "policy_unavailable"
      }
    },
    {
