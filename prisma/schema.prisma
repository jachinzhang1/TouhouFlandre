generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Character {
  id                    String   @id
  avatarUrl             String
  displayName           String
  nameSortKey           String
  searchText            String
  appearanceOrder       Int
  firstAppearanceWorkId String
  namesJson             String
  firstAppearanceJson   String
  speciesJson           String
  abilityDisplay        String
  abilityTagsJson       String
  affiliationsJson      String
  locationsJson         String
  rolesJson             String
  hairColorsJson        String
  playable              Boolean
  enabledAsAnswer       Boolean
  enabledAsGuess        Boolean
  difficultyTier        String
  sourceRefsJson        String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  firstAppearanceWork Work @relation(fields: [firstAppearanceWorkId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([enabledAsGuess, nameSortKey])
  @@index([enabledAsGuess, appearanceOrder])
  @@index([firstAppearanceWorkId])
}

model Work {
  id            String      @id
  titleZh       String
  titleJa       String
  titleEn       String?
  shortName     String
  type          String
  releaseYear   Int
  mainlineIndex Int?
  era           String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  characters    Character[]
}

model CatalogSnapshot {
  version        String        @id
  charactersJson String
  createdAt      DateTime      @default(now())
  sessions       GameSession[]
  dailyPuzzles   DailyPuzzle[]
  activeState    CatalogState?
}

model CatalogState {
  id             String          @id @default("current")
  currentVersion String          @unique
  updatedAt      DateTime        @updatedAt
  snapshot       CatalogSnapshot @relation(fields: [currentVersion], references: [version], onDelete: Restrict)
}

model DailyPuzzle {
  dateKey        String          @id
  catalogVersion String
  answerId       String
  createdAt      DateTime        @default(now())
  snapshot       CatalogSnapshot @relation(fields: [catalogVersion], references: [version], onDelete: Restrict)

  @@index([catalogVersion])
}

model GameSession {
  id             String          @id @default(cuid())
  mode           String
  contentType    String          @default("character")
  answerId       String
  catalogVersion String
  puzzleKey      String?
  status         String
  maxGuesses     Int
  guessesJson    String          @default("[]")
  version        Int             @default(0)
  startedAt      DateTime        @default(now())
  endedAt        DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  snapshot       CatalogSnapshot @relation(fields: [catalogVersion], references: [version], onDelete: Restrict)

  @@index([mode])
  @@index([status])
  @@index([catalogVersion])
}
