{
  "contract": "hso.search-ranking.v1",
  "cases": [
    {
      "name": "exact before prefix before substring",
      "query": "reimu",
      "descending": false,
      "entries": [
        {
          "id": "substring",
          "appearanceOrder": 1,
          "searchTerms": ["hakureireimu"],
          "expectedRank": { "kind": "substring", "position": 7, "lengthGap": 7 }
        },
        {
          "id": "prefix",
          "appearanceOrder": 2,
          "searchTerms": ["reimuhakurei"],
          "expectedRank": { "kind": "prefix", "position": 0, "lengthGap": 7 }
        },
        {
          "id": "exact",
          "appearanceOrder": 3,
          "searchTerms": ["reimu"],
          "expectedRank": { "kind": "exact", "position": 0, "lengthGap": 0 }
        },
        {
          "id": "unmatched",
          "appearanceOrder": 0,
          "searchTerms": ["marisa"],
          "expectedRank": null
        }
      ],
      "expectedIds": ["exact", "prefix", "substring"]
    },
    {
      "name": "shorter prefix wins",
      "query": "aki",
      "descending": false,
      "entries": [
        {
          "id": "long-prefix",
          "appearanceOrder": 1,
          "searchTerms": ["akishizuha"],
          "expectedRank": { "kind": "prefix", "position": 0, "lengthGap": 7 }
        },
        {
          "id": "short-prefix",
          "appearanceOrder": 2,
          "searchTerms": ["akiko"],
          "expectedRank": { "kind": "prefix", "position": 0, "lengthGap": 2 }
        }
      ],
      "expectedIds": ["short-prefix", "long-prefix"]
    },
    {
      "name": "earlier unicode substring wins before length",
      "query": "灵梦",
      "descending": false,
      "entries": [
        {
          "id": "late-short",
          "appearanceOrder": 1,
          "searchTerms": ["ab灵梦"],
          "expectedRank": { "kind": "substring", "position": 2, "lengthGap": 2 }
        },
        {
          "id": "early-long",
          "appearanceOrder": 2,
          "searchTerms": ["a灵梦long"],
          "expectedRank": { "kind": "substring", "position": 1, "lengthGap": 5 }
        }
      ],
      "expectedIds": ["early-long", "late-short"]
    },
    {
      "name": "shorter substring wins at the same position",
      "query": "灵梦",
      "descending": false,
      "entries": [
        {
          "id": "long",
          "appearanceOrder": 1,
          "searchTerms": ["a灵梦bc"],
          "expectedRank": { "kind": "substring", "position": 1, "lengthGap": 3 }
        },
        {
          "id": "short",
          "appearanceOrder": 2,
          "searchTerms": ["a灵梦b"],
          "expectedRank": { "kind": "substring", "position": 1, "lengthGap": 2 }
        }
      ],
      "expectedIds": ["short", "long"]
    },
    {
      "name": "best term represents the entry",
      "query": "reimu",
      "descending": false,
      "entries": [
        {
          "id": "multiple-terms",
          "appearanceOrder": 2,
          "searchTerms": ["hakureireimu", "reimu"],
          "expectedRank": { "kind": "exact", "position": 0, "lengthGap": 0 }
        },
        {
          "id": "prefix-only",
          "appearanceOrder": 1,
          "searchTerms": ["reimuhakurei"],
          "expectedRank": { "kind": "prefix", "position": 0, "lengthGap": 7 }
        }
      ],
      "expectedIds": ["multiple-terms", "prefix-only"]
    },
    {
      "name": "appearance and id break equal-rank ties",
      "query": "aki",
      "descending": false,
      "entries": [
        {
          "id": "later",
          "appearanceOrder": 2,
          "searchTerms": ["aki"],
          "expectedRank": { "kind": "exact", "position": 0, "lengthGap": 0 }
        },
        {
          "id": "zeta",
          "appearanceOrder": 1,
          "searchTerms": ["aki"],
          "expectedRank": { "kind": "exact", "position": 0, "lengthGap": 0 }
        },
        {
          "id": "alpha",
          "appearanceOrder": 1,
          "searchTerms": ["aki"],
          "expectedRank": { "kind": "exact", "position": 0, "lengthGap": 0 }
        }
      ],
      "expectedIds": ["alpha", "zeta", "later"]
    },
    {
      "name": "descending reverses rank but not stable ties",
      "query": "reimu",
      "descending": true,
      "entries": [
        {
          "id": "exact",
          "appearanceOrder": 3,
          "searchTerms": ["reimu"],
          "expectedRank": { "kind": "exact", "position": 0, "lengthGap": 0 }
        },
        {
          "id": "prefix",
          "appearanceOrder": 2,
          "searchTerms": ["reimuhakurei"],
          "expectedRank": { "kind": "prefix", "position": 0, "lengthGap": 7 }
        },
        {
          "id": "substring",
          "appearanceOrder": 1,
          "searchTerms": ["hakureireimu"],
          "expectedRank": { "kind": "substring", "position": 7, "lengthGap": 7 }
        }
      ],
      "expectedIds": ["substring", "prefix", "exact"]
    },
    {
      "name": "empty query falls back to appearance and id",
      "query": "",
      "descending": true,
      "entries": [
        {
          "id": "later",
          "appearanceOrder": 2,
          "searchTerms": ["reimu"],
          "expectedRank": null
        },
        {
          "id": "zeta",
          "appearanceOrder": 1,
          "searchTerms": ["marisa"],
          "expectedRank": null
        },
        {
          "id": "alpha",
          "appearanceOrder": 1,
          "searchTerms": ["sanae"],
          "expectedRank": null
        }
      ],
      "expectedIds": ["alpha", "zeta", "later"]
    }
  ]
}
